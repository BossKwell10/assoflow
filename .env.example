# Copier en .env pour le développement local. Ne jamais committer de vrai secret.
NODE_ENV=development
APP_ROLE=api
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CONSOLE_ORIGIN=http://localhost:5173
# Rôle propriétaire (migrations)
DATABASE_URL=postgres://assoflow_owner:assoflow@localhost:5432/assoflow
# Rôle applicatif (sans BYPASSRLS)
DATABASE_APP_URL=postgres://assoflow_app:assoflow@localhost:5432/assoflow
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
MIN_APP_VERSION=1.0.0
# Jetons d'accès JWT EdDSA (Ed25519, PEM). Absents hors production : paire éphémère générée au démarrage.
#   openssl genpkey -algorithm ed25519 -out secrets/jwt.key && openssl pkey -in secrets/jwt.key -pubout -out secrets/jwt.pub
# JWT_PRIVATE_KEY_FILE=secrets/jwt.key
# JWT_PUBLIC_KEY_FILE=secrets/jwt.pub
# Clé AES-256 des champs chiffrés (32 octets en base64) : openssl rand -base64 32
# FIELD_ENCRYPTION_KEY=
# Poivre des HMAC d'OTP et des codes de secours (16 caractères minimum) : openssl rand -hex 32
# OTP_PEPPER=
# Fournisseurs SMS par ordre de préférence (docs/06 §4) : `journal` (logs, local), `simulateur`/`simulateur_b`
# (recette, accusés simulés), `agregateur_a`/`agregateur_b` (fournisseurs réels, clés fournies plus tard).
SMS_PROVIDERS=journal
# SMS_SIMULATEUR_WEBHOOK_SECRET=
# SMS_SIMULATEUR_PANNE=aucune
# SMS_AGREGATEUR_A_URL=
# SMS_AGREGATEUR_A_TOKEN_FILE=secrets/sms-a.token
# SMS_AGREGATEUR_A_EXPEDITEUR=AssoFlow
# SMS_AGREGATEUR_A_WEBHOOK_SECRET_FILE=secrets/sms-a.webhook
# SMS_AGREGATEUR_B_URL=
# SMS_AGREGATEUR_B_TOKEN_FILE=secrets/sms-b.token
# Mot de passe du président de démonstration (pnpm --filter @assoflow/api seed:demo)
# SEED_MOT_DE_PASSE=
# Tâches asynchrones (imports, exports) : `processus` = dans l'API, sans worker (défaut hors production) ;
# `file` = files BullMQ sur Redis, consommées par le worker (`pnpm --filter @assoflow/api start:worker`).
# TACHES_EXECUTION=processus
# Clé HMAC des QR codes des cartes de membre (32 caractères minimum, obligatoire en production) : openssl rand -hex 32
# QR_SIGNING_KEY=
