{
  "name": "@assoflow/console",
  "version": "0.1.0",
  "private": true,
  "description": "Console web AssoFlow (espace association et plateforme)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "api:generer": "orval --config orval.config.ts",
    "api:verifier": "orval --config orval.config.ts && git diff --exit-code --stat -- src/api/generated && test -z \"$(git status --porcelain -- src/api/generated)\""
  },
  "dependencies": {
    "@assoflow/contracts": "workspace:*",
    "@mantine/core": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.135.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.8",
    "orval": "^8.49.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
