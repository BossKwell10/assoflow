{
  "name": "@assoflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend AssoFlow : API REST (console + mobile) et workers",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.api.js",
    "start": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@assoflow/contracts": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.6.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.0.0"
  }
}
